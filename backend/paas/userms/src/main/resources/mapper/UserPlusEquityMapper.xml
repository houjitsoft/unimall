    <select id="selectplusequitys" resultType="com.houjiang.commons.vo.base.PlusEquityEntityVO">
        select equity_id ,equity_name ,equity_type ,equity_value ,equity_addtime,
        equity_status ,
        red_effective ,red_provide ,discount_limit from ${database.prefix.userms}hou_user_plus_equity
        where equity_status = 1 and equity_id in
        <foreach collection="list" item="id" separator="," close=")" open="(">
            #{id}
        </foreach>
    </select>
    <select id="selectthalitypes" resultType="java.lang.String">
        select thali_equity
		from hou_base_merchant_plus_thali
    </select>
    <select id="selectPlusEquityByPage" resultType="com.houjiang.userms.entity.UserPlusEquityEntity">
    SELECT
    	equity_id,
    	equity_name,
    	equity_type,
    	equity_value,
    	equity_addtime,
    	equity_status,
    	red_effective,
    	red_provide,
    	discount_limit
    FROM
	${database.prefix.userms}hou_user_plus_equity
        <where>
            <if test="param.equityType != null and param.equityType != ''">
                equity_type = #{param.equityType}
            </if>
            <if test="param.equityName != null and param.equityName != ''">
                and equity_name like CONCAT('%',#{param.equityName },'%')
            </if>
            <if test="param.equityStatus != null and param.equityStatus != ''">
                and equity_status = #{param.equityStatus}
            </if>
        </where>
        order by equity_addtime desc
    </select>
    <select id="selectplusequity" resultType="com.houjiang.commons.vo.base.PlusEquityEntityVO">
        select equity_id,equity_name,equity_type,equity_value,equity_addtime,equity_status,
        red_effective,red_provide,discount_limit from ${database.prefix.userms}hou_user_plus_equity
        where equity_id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach> and equity_type in (2,3,4)
    </select>
    <select id="selectplusequitysTmp" resultType="com.houjiang.commons.vo.base.PlusEquityEntityVO">
        select equity_id,equity_name,equity_type,equity_value,equity_addtime,equity_status,
        red_effective,red_provide,discount_limit from ${database.prefix.userms}hou_user_plus_equity_temp
        where equity_status = 1 and equity_id in
        <foreach collection="list" item="id" separator="," close=")" open="(">
            #{id}
        </foreach>
        order by equity_type desc
    </select>
