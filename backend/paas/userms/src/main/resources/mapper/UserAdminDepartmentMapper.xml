<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.userms.mapper.UserAdminDepartmentMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.userms.entity.UserAdminDepartmentEntity">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="userDepartment" column="user_department" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,user_department
    </sql>
    <insert id="addDepartment">
        replace INTO ${database.prefix.userms}hou_user_admin_department (id,user_department) VALUES (#{param.id},#{param.userDepartment})
    </insert>
    <select id="selectDepartmentIsUser" resultType="java.lang.Integer">
    select
    count(*)
    from ${database.prefix.userms}hou_user_admin_department  ud
    INNER JOIN ${database.prefix.userms}hou_user_admin_base ub
     on ud.id = ub.user_department
     where ud.id = #{id}
    </select>
</mapper>
