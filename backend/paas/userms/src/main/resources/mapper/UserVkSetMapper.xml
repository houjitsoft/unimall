        <result property="vkState" column="vk_state" jdbcType="INTEGER"/>
    </resultMap>
    <insert id="insertEnableVk">
        insert into ${database.prefix.userms}hou_user_vk_set
        <trim prefix="(" suffix=")" suffixOverrides="," >
