<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.base.mapper.BaseTagClassMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.base.entity.BaseTagClassEntity">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="memberId" column="member_id" jdbcType="INTEGER"/>
            <result property="tagId" column="tag_id" jdbcType="VARCHAR"/>
            <result property="memberClassId" column="member_class_id" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,member_id,tag_id,
        member_class_id
    </sql>
    <select id="getMemberClassIdByUserId" resultType="java.lang.Integer">
         select member_class_id from ${database.prefix.userms}hou_base_tag_class where member_id=#{userId}
    </select>
    <select id="queryByMemberClassId" resultType="java.lang.String">
        select member_id from ${database.prefix.userms}hou_base_tag_class where member_class_id = #{id}
    </select>
</mapper>
