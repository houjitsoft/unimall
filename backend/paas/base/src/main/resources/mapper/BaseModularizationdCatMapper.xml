<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.base.mapper.BaseModularizationdCatMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.base.entity.BaseModularizationdCatEntity">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="pageName" column="page_name" jdbcType="VARCHAR"/>
            <result property="pageType" column="page_type" jdbcType="INTEGER"/>
            <result property="pageData" column="page_data" jdbcType="VARCHAR"/>
            <result property="pageStart" column="page_start" jdbcType="INTEGER"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,page_name,page_type,
        page_data,page_start,create_time
    </sql>
    <insert id="addModularizationdCat">
    INSERT into ${database.prefix.userms}hou_base_modularizationd_cat (
        page_name,
        page_type,
        page_data,
        page_start,
        create_time )
    VALUES
	    (#{param.pageName},
	    #{param.pageType},
	    #{param.pageData},
	    2,
	    now())
    </insert>
    <update id="updateModularizationdCat">
        UPDATE ${database.prefix.userms}hou_base_modularizationd_cat
        <set >
            <if test="param.pageName != null" >
                page_name = #{param.pageName},
            </if>
            <if test="param.pageType != null" >
                page_type = #{param.pageType},
            </if>
            <if test="param.pageData != null" >
                page_data = #{param.pageData},
            </if>
            <if test="param.pageStart != null" >
                page_start = #{param.pageStart},
            </if>
        </set>
        where id = #{param.id}
    </update>
    <select id="selectAllModularizationdCat"
            resultType="com.houjiang.base.entity.BaseModularizationdCatEntity">
        select id,page_name,page_type,page_start,create_time from ${database.prefix.userms}hou_base_modularizationd_cat
        <if test="null != param.pageName">
            where page_name like concat('%' ,#{param.pageName} ,'%')
        </if>
        order by create_time desc
    </select>
</mapper>
