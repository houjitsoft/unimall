<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.base.mapper.BaseSearchWordMapper">

    <resultMap type="com.houjiang.base.entity.BaseSearchWordEntity" id="BaseSearchWordMap">
        <result property="searchId" column="search_id" jdbcType="INTEGER"/>
        <result property="searchKeyword" column="search_keyword" jdbcType="VARCHAR"/>
        <result property="searchCharIndex" column="search_char_index" jdbcType="VARCHAR"/>
        <result property="searchNums" column="search_nums" jdbcType="INTEGER"/>
    </resultMap>
    <sql id="Base_Column_List" >
        search_id, search_keyword, search_char_index, search_nums
    </sql>
    <insert id="insertSelective">
        insert into ${database.prefix.userms}hou_base_search_word
        <trim prefix="(" suffix=")" suffixOverrides="," >
            <if test="searchId != null" >
                search_id,
            </if>
            <if test="searchKeyword != null" >
                search_keyword,
            </if>
            <if test="searchCharIndex != null" >
                search_char_index,
            </if>
            <if test="searchNums != null" >
                search_nums,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides="," >
            <if test="searchId != null" >
                #{searchId,jdbcType=INTEGER},
            </if>
            <if test="searchKeyword != null" >
                #{searchKeyword,jdbcType=VARCHAR},
            </if>
            <if test="searchCharIndex != null" >
                #{searchCharIndex,jdbcType=VARCHAR},
            </if>
            <if test="searchNums != null" >
                #{searchNums,jdbcType=INTEGER},
            </if>
        </trim>
    </insert>
    <update id="updateByPrimaryKeySelective">
        UPDATE ${database.prefix.userms}hou_base_search_word
        <set >
            <if test="searchKeyword != null" >
                search_keyword = #{searchKeyword,jdbcType=VARCHAR},
            </if>
            <if test="searchCharIndex != null" >
                search_char_index = #{searchCharIndex,jdbcType=VARCHAR},
            </if>
            <if test="searchNums != null" >
                search_nums = #{searchNums,jdbcType=INTEGER},
            </if>
        </set>
        where search_id = #{searchId,jdbcType=INTEGER}
    </update>

    <select id="selectBySearchName" resultType="com.houjiang.commons.dto.goods.GoodsMerchantSearchWordDTO">
        select
        <include refid="Base_Column_List" />
        from ${database.prefix.userms}hou_base_search_word
        where search_keyword = #{commonName,jdbcType=VARCHAR} order by search_nums desc limit 1
    </select>
    <select id="querySearchWord" resultType="com.houjiang.base.entity.BaseSearchWordEntity">
        select search_id,search_keyword,search_nums from ${database.prefix.userms}hou_base_search_word
        <where>
            <if test="param.searchKeyword != null and param.searchKeyword != ''">
                and search_keyword like concat('%',#{param.searchKeyword},'%')
            </if>
        </where>
        order by search_nums desc
    </select>
    <select id="queryKeyWords" resultType="java.lang.String">
        select
        search_keyword
        from ${database.prefix.userms}hou_base_search_word
        order by search_nums desc
        limit 6
    </select>


</mapper>

