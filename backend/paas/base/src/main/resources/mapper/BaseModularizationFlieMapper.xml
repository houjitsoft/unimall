<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.base.mapper.BaseModularizationFlieMapper">

    <resultMap type="com.houjiang.base.entity.BaseModularizationFlieEntity" id="BaseModularizationFlieMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="fileName" column="file_name" jdbcType="VARCHAR"/>
        <result property="fileUrl" column="file_url" jdbcType="VARCHAR"/>
        <result property="fileCoverUrl" column="file_cover_url" jdbcType="VARCHAR"/>
        <result property="fileType" column="file_type" jdbcType="INTEGER"/>
        <result property="fileCreateTime" column="file_create_time" jdbcType="TIMESTAMP"/>
    </resultMap>
    <insert id="manageUploadVideo">
        insert into ${database.prefix.userms}hou_base_modularization_flie (file_name,file_url,file_cover_url,file_type,file_create_time)
        values (#{file.fileName},#{file.fileUrl},#{file.fileCoverUrl},#{file.fileType},now())
    </insert>
    <insert id="manageUpload">
        insert into ${database.prefix.userms}hou_base_modularization_flie (file_name,file_url,file_type,file_create_time)
        values (#{file.fileName},#{file.fileUrl},#{file.fileType},now())
    </insert>
    <insert id="manageUploadShop">
        insert into ${database.prefix.userms}hou_base_modularization_flie_shop (shop_id,file_name,file_url,file_type,file_create_time)
        values (#{file.shopId},#{file.fileName},#{file.fileUrl},#{file.fileType},now())
    </insert>
    <select id="queryYfModularizationFlie" resultType="com.houjiang.base.vo.ModularizationFlieVO">
        select id, file_name,file_url, file_cover_url ,file_type,file_create_time
        from ${database.prefix.userms}hou_base_modularization_flie as ym
        <where>
            <if test='param.fileName != null'>
                and ym.file_name like  concat('%',#{param.fileName},'%')
            </if>
            <if test='param.fileType != null'>
                and ym.file_type = #{param.fileType}
            </if>
        </where>
        ORDER BY ym.file_create_time desc
    </select>
    <select id="queryYfModularizationFlieShop" resultType="com.houjiang.base.vo.ModularizationFlieVO">
        select id,shop_id, file_name,file_url, file_cover_url ,file_type,file_create_time
        from ${database.prefix.userms}hou_base_modularization_flie_shop as ym
        <where>
           <if test='param.fileName != null'>
               and ym.file_name like  concat('%',#{param.fileName},'%')
           </if>
           <if test='param.fileType != null'>
               and ym.file_type = #{param.fileType}
           </if>
           <if test='param.shopId != null'>
               and ym.shop_id = #{param.shopId}
           </if>
        </where>
        ORDER BY ym.file_create_time desc
    </select>

    <insert id="indexShopVideoUrl">
        insert into ${database.prefix.userms}hou_base_modularization_flie_shop (shop_id,file_name,file_url,file_cover_url,file_type,file_create_time)
        values (#{shopId},#{houModularizationFlie.fileName},#{houModularizationFlie.fileUrl},#{houModularizationFlie.fileCoverUrl},#{houModularizationFlie.fileType},now())
    </insert>

</mapper>
