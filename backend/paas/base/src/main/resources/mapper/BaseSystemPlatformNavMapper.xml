<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.base.mapper.BaseSystemPlatformNavMapper">

    <resultMap type="com.houjiang.base.entity.BaseSystemPlatformNavEntity" id="BaseSystemPlatformNavMap">
        <result property="navId" column="nav_id" jdbcType="INTEGER"/>
        <result property="navTitle" column="nav_title" jdbcType="VARCHAR"/>
        <result property="navUrl" column="nav_url" jdbcType="VARCHAR"/>
        <result property="navNewOpen" column="nav_new_open" jdbcType="INTEGER"/>
        <result property="navDisplayorder" column="nav_displayorder" jdbcType="INTEGER"/>
        <result property="navActive" column="nav_active" jdbcType="INTEGER"/>
        <result property="navProperty" column="nav_property" jdbcType="INTEGER"/>
    </resultMap>
    <insert id="insertPlatformNav">
        insert into ${database.prefix.userms}hou_base_system_platform_nav
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="param.navId != null">
                nav_id,
            </if>
            <if test="param.navTitle != null">
                nav_title,
            </if>
            <if test="param.navUrl != null">
                nav_url,
            </if>
            <if test="param.navNewOpen != null">
                nav_new_open,
            </if>
            <if test="param.navDisplayorder != null">
                nav_displayorder,
            </if>
            <if test="param.navActive != null">
                nav_active,
            </if>
            <if test="param.navProperty != null">
                nav_property,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="param.navId != null">
                #{param.navId,jdbcType=INTEGER},
            </if>
            <if test="param.navTitle != null">
                #{param.navTitle,jdbcType=VARCHAR},
            </if>
            <if test="param.navUrl != null">
                #{param.navUrl,jdbcType=VARCHAR},
            </if>
            <if test="param.navNewOpen != null">
                #{param.navNewOpen,jdbcType=BIT},
            </if>
            <if test="param.navDisplayorder != null">
                #{param.navDisplayorder,jdbcType=TINYINT},
            </if>
            <if test="param.navActive != null">
                #{param.navActive,jdbcType=BIT},
            </if>
            <if test="param.navProperty != null">
                #{param.navProperty,jdbcType=INTEGER},
            </if>
        </trim>
    </insert>
    <update id="updatePlatformNav">
        UPDATE ${database.prefix.userms}hou_base_system_platform_nav
        <set>
            <if test="param.navTitle != null">
                nav_title = #{param.navTitle,jdbcType=VARCHAR},
            </if>
            <if test="param.navUrl != null">
                nav_url = #{param.navUrl,jdbcType=VARCHAR},
            </if>
            <if test="param.navNewOpen != null">
                nav_new_open = #{param.navNewOpen,jdbcType=BIT},
            </if>
            <if test="param.navDisplayorder != null">
                nav_displayorder =
                #{param.navDisplayorder,jdbcType=TINYINT},
            </if>
            <if test="param.navActive != null">
                nav_active = #{param.navActive,jdbcType=BIT},
            </if>
            <if test="param.navProperty != null">
                nav_property = #{param.navProperty,jdbcType=INTEGER},
            </if>
        </set>
        where nav_id = #{param.navId,jdbcType=INTEGER}
    </update>
    <select id="selectPlatformNav" resultType="com.houjiang.base.vo.index.WebSystemPlatformNavVO">
          select
          nav_id,nav_title, nav_url,  nav_new_open
          from ${database.prefix.userms}hou_base_system_platform_nav
          where nav_active=1 and nav_property = #{navProperty} order by nav_displayorder asc
    </select>

</mapper>

