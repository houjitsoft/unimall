<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.base.mapper.BaseMerchantPlusThaliMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.base.entity.BaseMerchantPlusThaliEntity">
            <id property="thaliId" column="thali_id" jdbcType="INTEGER"/>
            <result property="thaliType" column="thali_type" jdbcType="INTEGER"/>
            <result property="thaliPrice" column="thali_price" jdbcType="DECIMAL"/>
            <result property="thaliEquity" column="thali_equity" jdbcType="VARCHAR"/>
            <result property="thaliRecommend" column="thali_recommend" jdbcType="INTEGER"/>
            <result property="thaliStatus" column="thali_status" jdbcType="INTEGER"/>
            <result property="thaliUpdatetime" column="thali_updatetime" jdbcType="TIMESTAMP"/>
            <result property="thaliOldprice" column="thali_oldPrice" jdbcType="DECIMAL"/>
    </resultMap>

    <sql id="Base_Column_List">
        thali_id,thali_type,thali_price,
        thali_equity,thali_recommend,thali_status,
        thali_updatetime,thali_oldPrice
    </sql>
    <insert id="insertplusthali">
        insert into ${database.prefix.userms}hou_base_merchant_plus_thali
        <trim prefix="(thali_updatetime," suffix=")" suffixOverrides=",">
            <if test="param.thaliType != null and param.thaliType != ''">
                thali_type,
            </if>
            <if test="param.thaliPrice != null and param.thaliPrice != ''">
                thali_price,
            </if>
            <if test="param.thaliEquity != null and param.thaliEquity != ''">
                thali_equity,
            </if>
            <if test="param.thaliRecommend != null and param.thaliRecommend != ''">
                thali_recommend,
            </if>
            <if test="param.thaliStatus != null and param.thaliStatus != ''">
                thali_status,
            </if>
            <if test="param.thaliOldPrice != null and param.thaliOldPrice != ''">
                thali_oldPrice,
            </if>
        </trim>
        <trim prefix="values (now()," suffix=")" suffixOverrides=",">
            <if test="param.thaliType != null and param.thaliType != ''">
                #{param.thaliType},
            </if>
            <if test="param.thaliPrice != null and param.thaliPrice != ''">
                #{param.thaliPrice},
            </if>
            <if test="param.thaliEquity != null and param.thaliEquity != ''">
                #{param.thaliEquity},
            </if>
            <if test="param.thaliRecommend != null and param.thaliRecommend != ''">
                #{param.thaliRecommend},
            </if>
            <if test="param.thaliStatus != null and param.thaliStatus != ''">
                #{param.thaliStatus},
            </if>
            <if test="param.thaliOldPrice != null and param.thaliOldPrice != ''">
                #{param.thaliOldPrice},
            </if>
        </trim>
    </insert>
    <update id="updateplusthali">
        UPDATE ${database.prefix.userms}hou_base_merchant_plus_thali
        <set>
            thali_updatetime = now(),
            <if test="param.thaliPrice != null and param.thaliPrice != ''">
                thali_price = #{param.thaliPrice},
            </if>
            <if test="param.thaliEquity != null and param.thaliEquity != ''">
                thali_equity = #{param.thaliEquity},
            </if>
            <if test="param.thaliRecommend != null and param.thaliRecommend != ''">
                thali_recommend = #{param.thaliRecommend},
            </if>
            <if test="param.thaliStatus != null">
                thali_status = #{param.thaliStatus},
            </if>
            <if test="param.thaliOldPrice != null and param.thaliOldPrice != ''">
                thali_oldPrice = #{param.thaliOldPrice},
            </if>
        </set>
        where thali_type = #{param.thaliType}
    </update>
    <select id="selectthalitype1" resultType="com.houjiang.base.entity.BaseMerchantPlusThaliEntity">
    SELECT
    	gmpt.thali_id,
    	gmpt.thali_type,
    	gmpt.thali_price,
    	po.plus_equity AS thaliEquity,
    	gmpt.thali_recommend,
    	gmpt.thali_status,
    	gmpt.thali_oldPrice
    FROM
    	base_merchant_plus_thali gmpt
    	LEFT JOIN ${database.prefix.userms}hou_user_plus_order po ON gmpt.thali_type = po.thali_type
    WHERE
	    po.plus_orderid = #{param}
    </select>
</mapper>
