<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.base.mapper.BaseVkSetMapper">

    <resultMap type="com.houjiang.base.entity.BaseVkSetEntity" id="BaseVkSetMap">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="commissionConfig" column="commission_config" jdbcType="INTEGER"/>
        <result property="oneTgRate" column="tg_rate" jdbcType="VARCHAR"/>
        <result property="twoTgRate" column="tg_rate" jdbcType="VARCHAR"/>
        <result property="fxRate" column="fx_rate" jdbcType="VARCHAR"/>
        <result property="backgroundImage" column="background_image" jdbcType="VARCHAR"/>
        <result property="afterSalesDays" column="after_sales_days" jdbcType="INTEGER"/>
        <result property="vkState" column="vk_state" jdbcType="INTEGER"/>
    </resultMap>
    <insert id="insertCommissionSetting">
        insert into ${database.prefix.userms}hou_base_vk_set
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="param.commissionConfig != null">
                commission_config,
            </if>
            <if test="param.oneTgRate!=null">
                one_tg_rate,
            </if>
            <if test="param.twoTgRate!=null">
                two_tg_rate,
            </if>
            <if test="param.fxRate != null">
                fx_rate,
            </if>
            <if test="param.backgroundImage != null">
                background_image,
            </if>
            <if test="param.afterSalesDays != null">
                after_sales_days,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="param.commissionConfig != null">
                #{param.commissionConfig,jdbcType=INTEGER},
            </if>
            <if test="param.oneTgRate != null">
                #{param.oneTgRate},
            </if>
            <if test="param.twoTgRate != null">
                #{param.twoTgRate},
            </if>
            <if test="param.fxRate != null">
                #{param.fxRate,jdbcType=VARCHAR},
            </if>
            <if test="param.backgroundImage != null">
                #{param.backgroundImage,jdbcType=VARCHAR},
            </if>
            <if test="param.afterSalesDays != null">
                #{param.afterSalesDays,jdbcType=INTEGER},
            </if>
        </trim>
    </insert>
    <update id="updateCommissionSetting">
        UPDATE ${database.prefix.userms}hou_base_vk_set
        <set>
            <if test="param.commissionConfig != null">
                commission_config=#{param.commissionConfig},
            </if>
            <if test="param.oneTgRate != null">
                one_tg_rate=#{param.oneTgRate},
            </if>
            <if test="param.twoTgRate != null">
                two_tg_rate=#{param.twoTgRate},
            </if>
            <if test="param.fxRate != null">
                fx_rate=#{param.fxRate},
            </if>
            <if test="param.backgroundImage != null">
                background_image=#{param.backgroundImage},
            </if>
            <if test="param.afterSalesDays != null">
                after_sales_days=#{param.afterSalesDays}
            </if>
        </set>
    </update>
    <select id="selectByPrimaryKey" resultType="com.houjiang.commons.vo.fx.GoodsVkSetVO">
        select id,
               commission_config,
               one_tg_rate,
               two_tg_rate,
               fx_rate,
               background_image,
               after_sales_days,
               vk_state
        from ${database.prefix.userms}hou_base_vk_set
        where id = #{id,jdbcType=INTEGER}
    </select>


</mapper>
