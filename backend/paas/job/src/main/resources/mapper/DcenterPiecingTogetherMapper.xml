<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.job.mapper.DcenterPiecingTogetherMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.job.entity.DcenterPiecingTogetherEntity">
            <id property="pintuanId" column="pintuan_id" jdbcType="INTEGER"/>
            <result property="shopId" column="shop_id" jdbcType="INTEGER"/>
            <result property="userId" column="user_id" jdbcType="VARCHAR"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="startTime" column="start_time" jdbcType="TIMESTAMP"/>
            <result property="endTime" column="end_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        pintuan_id,shop_id,user_id,
        name,start_time,end_time
    </sql>
    <select id="getDecenterPiecingTogetherVOList" resultType="com.houjiang.job.vo.DcenterPiecingTogetherVO">
        select
        <include refid="Base_Column_List"/>
        from ${database.prefix.activity}hou_addon_activity_piecing_together limit #{pageNum},#{pageSize}
    </select>
</mapper>
