<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.job.mapper.DcenterUserInfoDetailMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.job.entity.DcenterUserInfoDetailEntity">
            <id property="userId" column="user_id" jdbcType="VARCHAR"/>
            <result property="userPlatform" column="user_platform" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        user_id,user_avatar,user_platform
    </sql>
    <select id="getDecenterUserInfoDetailVOList" resultType="com.houjiang.job.vo.DcenterUserInfoDetailVO">
        select
            user_id,
            user_avatar,
            user_platform
        from ${database.prefix.userms}hou_user_info_detail
        limit #{pageNum},#{pageSize}
    </select>
</mapper>
