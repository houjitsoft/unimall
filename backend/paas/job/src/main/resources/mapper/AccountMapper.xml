<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.houjiang.job.mapper.AccountMapper">

    <select id="getAccountByOverdue" resultType="java.lang.String">
        SELECT accounting_period_id
        FROM ${database.prefix.order}hou_order_accounting_period
        WHERE NOW() > ADDDATE(repayment_date, 1)
          AND account_status != 2
    </select>

    <update id="updateAccountStatus">
        update ${database.prefix.order}hou_order_accounting_period set account_status = 3
        where accounting_period_id = #{accountingPeriodId}
    </update>

    <update id="updateAccountIsSue">
        update ${database.prefix.order}hou_order_accounting_period set is_issue = 1
        where monthly_time = #{monthlyTime}
    </update>

    <update id="clearAccountMonthCollection">
        update ${database.prefix.order}hou_order_accounting_period set month_collection = 0
    </update>

    <update id="clearAccountMonthAmountUsed">
        update ${database.prefix.business}hou_merchant_mall_shop_account_period set month_amount_used = 0
    </update>

    <update id="updateAccountIsRepayment">
        update ${database.prefix.order}hou_order_accounting_period set is_repayment = 1
        where monthly_time = #{monthlyTime}
    </update>

</mapper>