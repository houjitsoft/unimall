<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.houjiang.job.mapper.ActivityNoneListMapper">

    <select id="queryGuoQiVirtualGoods" resultType="java.lang.String">
		select common_id
		from ${database.prefix.goods}hou_goods_common
		where now() > period_of_validity
		  and virtual_goods = 0
		  and common_state = 1
	</select>

    <update id="updateGoodsStart">
		update ${database.prefix.goods}hou_goods_common set  common_state = 0 where common_id = #{commonId}
	</update>

	<select id="queryAllGoodsIdByCommonId" resultType="java.lang.Integer">
		SELECT goods_id FROM ${database.prefix.goods}hou_goods_base
		<where>
			and common_id in
			<foreach collection="commonIdList" separator="," open="(" close=")" item="commonId">
				#{commonId}
			</foreach>
		</where>
	</select>

	<update id="updateGoodsState">
		update ${database.prefix.goods}hou_goods_base set goods_is_shelves = 2 where goods_id = #{goodsId}
	</update>
</mapper>
