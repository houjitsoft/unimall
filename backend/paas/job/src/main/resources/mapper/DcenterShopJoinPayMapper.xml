<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.job.mapper.DcenterShopJoinPayMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.job.entity.DcenterShopJoinPayEntity">
            <id property="payId" column="pay_id" jdbcType="INTEGER"/>
            <result property="userId" column="user_id" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        pay_id,user_id
    </sql>
    <select id="getDecenterShopJoinPayVOList" resultType="com.houjiang.job.vo.DcenterShopJoinPayVO">
        select
        pay_id,user_id,audit_status
        from ${database.prefix.supplier}hou_supplier_shop_join_pay limit #{pageNum},#{pageSize}
    </select>
</mapper>
