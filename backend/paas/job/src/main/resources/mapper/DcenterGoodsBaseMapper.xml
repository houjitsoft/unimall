<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.job.mapper.DcenterGoodsBaseMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.job.entity.DcenterGoodsBaseEntity">
            <id property="goodsId" column="goods_id" jdbcType="INTEGER"/>
            <result property="commonId" column="common_id" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        goods_id,common_id
    </sql>
    <select id="getDecenterGoodsBaseVOList" resultType="com.houjiang.job.vo.DcenterGoodsBaseVO">
        select goods_id,common_id from ${database.prefix.goods}hou_goods_base limit #{pageNum},#{pageSize}
    </select>
</mapper>
