<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.job.mapper.DcenterGoodsCatMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.job.entity.DcenterGoodsCatEntity">
            <id property="catId" column="cat_id" jdbcType="INTEGER"/>
            <result property="catName" column="cat_name" jdbcType="VARCHAR"/>
            <result property="catParentId" column="cat_parent_id" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        cat_id,cat_name,cat_parent_id
    </sql>
    <select id="getDecenterGoodsCatVOList" resultType="com.houjiang.job.vo.DcenterGoodsCatVO">
        select
        cat_id,cat_name,cat_parent_id
        from ${database.prefix.goods}hou_goods_cat limit #{pageNum},#{pageSize}
    </select>
</mapper>
