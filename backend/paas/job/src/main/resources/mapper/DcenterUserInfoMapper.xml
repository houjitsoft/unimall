<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.job.mapper.DcenterUserInfoMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.job.entity.DcenterUserInfoEntity">
            <id property="userId" column="user_id" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        user_id,user_name,user_integral,create_time
    </sql>
    <select id="getDecenterUserInfoVOList" resultType="com.houjiang.job.vo.DcenterUserInfoVO">
        select
            user_id,
            user_name,
            user_integral,
            create_time
        from ${database.prefix.userms}hou_user_info
        limit #{pageNum},#{pageSize}
    </select>
</mapper>
