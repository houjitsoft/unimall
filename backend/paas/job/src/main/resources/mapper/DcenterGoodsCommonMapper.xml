<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.job.mapper.DcenterGoodsCommonMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.job.entity.DcenterGoodsCommonEntity">
            <id property="commonId" column="common_id" jdbcType="INTEGER"/>
            <result property="commonName" column="common_name" jdbcType="VARCHAR"/>
            <result property="shopStatus" column="shop_status" jdbcType="BOOLEAN"/>
            <result property="commonSalenum" column="common_salenum" jdbcType="INTEGER"/>
            <result property="commonImage" column="common_image" jdbcType="VARCHAR"/>
            <result property="commonState" column="common_state" jdbcType="INTEGER"/>
            <result property="commonVerify" column="common_verify" jdbcType="TINYINT"/>
            <result property="commonAddTime" column="common_add_time" jdbcType="TIMESTAMP"/>
            <result property="commonCollect" column="common_collect" jdbcType="INTEGER"/>
            <result property="commonEvaluate" column="common_evaluate" jdbcType="INTEGER"/>
            <result property="commonIsScreen" column="common_is_screen" jdbcType="INTEGER"/>
            <result property="integralGoods" column="integral_goods" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        common_id,common_name,shop_status,
        common_salenum,common_image,common_state,
        common_verify,common_add_time,common_collect,
        common_evaluate,common_is_screen,integral_goods
    </sql>
    <select id="getDecenterGoodsCommonVOList" resultType="com.houjiang.job.vo.DcenterGoodsCommonVO">
        select common_id,common_name,shop_status,
        common_salenum,common_image,common_state,shop_id,
        common_verify,common_add_time,common_collect,
        common_evaluate,common_is_screen,integral_goods from ${database.prefix.goods}hou_goods_common limit #{pageNum},#{pageSize}
    </select>
</mapper>
