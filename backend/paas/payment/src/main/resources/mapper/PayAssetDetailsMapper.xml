<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.payment.mapper.PayAssetDetailsMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.payment.entity.PayAssetDetailsEntity">
        <id property="detailId" column="detail_id" jdbcType="INTEGER"/>
        <result property="detailType" column="detail_type" jdbcType="INTEGER"/>
        <result property="assetType" column="asset_type" jdbcType="INTEGER"/>
        <result property="assetAmount" column="asset_amount" jdbcType="DECIMAL"/>
        <result property="assetDirection" column="asset_direction" jdbcType="VARCHAR"/>
        <result property="orderId" column="order_id" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="lastUpdateTime" column="last_update_time" jdbcType="TIMESTAMP"/>
        <result property="payType" column="pay_type" jdbcType="INTEGER"/>
        <result property="userId" column="user_id" jdbcType="VARCHAR"/>
        <result property="detailComment" column="detail_comment" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        detail_id,detail_type,asset_type,
        asset_amount,asset_direction,order_id,
        create_time,last_update_time,pay_type,
        user_id,detail_comment
    </sql>
    <insert id="insertDetail">
        insert into ${database.prefix.payment}hou_pay_asset_details
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="param.detailType != null">
                detail_type,
            </if>
            <if test="param.assetType != null">
                asset_type,
            </if>
            <if test="param.assetAmount != null">
                asset_amount,
            </if>
            <if test="param.assetDirection != null and param.assetDirection != ''">
                asset_direction,
            </if>
            <if test="param.orderId != null and param.orderId != ''">
                order_id,
            </if>
            <if test="param.payType != null">
                pay_type,
            </if>
            <if test="param.userId != null">
                user_id,
            </if>
            <if test="param.detailComment != null and param.detailComment != ''">
                detail_comment,
            </if>

        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="param.detailType != null">
                #{param.detailType,jdbcType=INTEGER},
            </if>
            <if test="param.assetType != null">
                #{param.assetType,jdbcType=INTEGER},
            </if>
            <if test="param.assetAmount != null">
                #{param.assetAmount,jdbcType=DECIMAL},
            </if>
            <if test="param.assetDirection != null and param.assetDirection != ''">
                #{param.assetDirection,jdbcType=VARCHAR},
            </if>
            <if test="param.orderId != null and param.orderId != ''">
                #{param.orderId,jdbcType=VARCHAR},
            </if>
            <if test="param.payType != null">
                #{param.payType,jdbcType=INTEGER},
            </if>
            <if test="param.userId != null">
                #{param.userId,jdbcType=INTEGER},
            </if>
            <if test="param.detailComment != null and param.detailComment != ''">
                #{param.detailComment,jdbcType=VARCHAR},
            </if>

        </trim>
    </insert>
    <insert id="insertUserMoneyDetail">
        insert into ${database.prefix.payment}hou_pay_asset_details
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="param.detailType != null">
                detail_type,
            </if>
            <if test="param.assetType != null">
                asset_type,
            </if>
            <if test="param.assetAmount != null">
                asset_amount,
            </if>
            <if test="param.assetDirection != null and param.assetDirection != ''">
                asset_direction,
            </if>
            <if test="param.orderId != null and param.orderId != ''">
                order_id,
            </if>
            <if test="param.payType != null">
                pay_type,
            </if>
            <if test="param.userId != null">
                user_id,
            </if>
            <if test="param.detailComment != null and param.detailComment != ''">
                detail_comment,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="param.detailType != null">
                #{param.detailType,jdbcType=INTEGER},
            </if>
            <if test="param.assetType != null">
                #{param.assetType,jdbcType=INTEGER},
            </if>
            <if test="param.assetAmount != null">
                #{param.assetAmount,jdbcType=DECIMAL},
            </if>
            <if test="param.assetDirection != null and param.assetDirection != ''">
                #{param.assetDirection,jdbcType=VARCHAR},
            </if>
            <if test="param.orderId != null and param.orderId != ''">
                #{param.orderId,jdbcType=VARCHAR},
            </if>
            <if test="param.payType != null">
                #{param.payType,jdbcType=INTEGER},
            </if>
            <if test="param.userId != null">
                #{param.userId,jdbcType=INTEGER},
            </if>
            <if test="param.detailComment != null and param.detailComment != ''">
                #{param.detailComment,jdbcType=VARCHAR},
            </if>
        </trim>
    </insert>
    <select id="queryAssetList" resultType="com.houjiang.payment.vo.AssetInfoVO">
        select detail_id as detailId,
        detail_type as detailType,
        asset_type as assetType,
        asset_amount as assetAmount,
        asset_direction as assetDirection,
        order_id as orderId,
        create_time as createTime
        from ${database.prefix.payment}hou_pay_asset_details
        where user_id = #{param.userId}
        <if test="param.assetType != null">
            and asset_type = #{param.assetType}
        </if>
        <if test="param.detailType != null">
            and detail_type = #{param.detailType}
        </if>
        <if test="param.payType != null">
            and pay_type = #{param.payType}
        </if>
        <if test="param.startTime != null and param.startTime !=''">
            and create_time >= #{param.startTime}
        </if>
        <if test="param.finishTime != null and param.finishTime !=''">
            <![CDATA[ and create_time <= #{param.finishTime} ]]>
        </if>
        order by create_time desc
    </select>
    <select id="queryAssetDetail" resultType="com.houjiang.payment.vo.AssetInfoVO">
        select detail_id       as detailId,
               detail_type     as detailType,
               asset_type      as assetType,
               asset_amount    as assetAmount,
               asset_direction as assetDirection,
               order_id        as orderId,
               create_time     as createTime,
               detail_comment  as detailComment
        from ${database.prefix.payment}hou_pay_asset_details
        where detail_id = #{detailId}
    </select>
    <select id="queryExpPlatformAssetList" resultType="com.houjiang.payment.vo.AssetPlatformQueryExpVO">
        select
        a.detail_type as detailType,
        a.asset_amount as assetAmount,
        a.asset_direction as assetDirection,
        a.order_id as orderId,
        a.create_time as createTime,
        b.user_nickname as userNickname,
        b.user_mobile as userMobile
        from ${database.prefix.payment}hou_pay_asset_details a
        left join ${database.prefix.userms}hou_user_info b
        on a.user_id = b.user_id
        where a.user_id = #{param.userId}
        <if test="param.assetType != null">
            and a.asset_type = #{param.assetType}
        </if>
        <if test="param.detailType != null">
            and a.detail_type = #{param.detailType}
        </if>
        <if test="param.payType != null">
            and a.pay_type = #{param.payType}
        </if>
        <if test="param.startTime != null and param.startTime !=''">
            and a.create_time >= #{param.startTime}
        </if>
        <if test="param.finishTime != null and param.finishTime !=''">
            <![CDATA[ and a.create_time <= #{param.finishTime} ]]>
        </if>
        order by a.create_time desc
    </select>
</mapper>
