<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.goods.mapper.GoodsTagClassInfoMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.goods.entity.GoodsTagClassInfoEntity">
            <id property="classId" column="class_id" jdbcType="INTEGER"/>
            <result property="className" column="class_name" jdbcType="VARCHAR"/>
            <result property="isActive" column="is_active" jdbcType="INTEGER"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="lastUpdatedTime" column="last_updated_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        class_id,class_name,is_active,
        create_time,last_updated_time
    </sql>
    <select id="queryTagClass" resultType="com.houjiang.goods.vo.CommunityArticleTagClassVO">
        select class_id,
			   class_name
		from goods_tag_class_info
    </select>
</mapper>
