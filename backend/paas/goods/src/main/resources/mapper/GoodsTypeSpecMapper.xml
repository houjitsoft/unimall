<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.goods.mapper.GoodsTypeSpecMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.goods.entity.GoodsTypeSpecEntity">
            <id property="typeSpecId" column="type_spec_id" jdbcType="INTEGER"/>
            <result property="typeId" column="type_id" jdbcType="INTEGER"/>
            <result property="specId" column="spec_id" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        type_spec_id,type_id,spec_id
    </sql>
    <insert id="insertTypeSpecBatch">
        insert into goods_type_spec( type_id,spec_id) values
        <foreach collection="typeSpecList" item="brand" index="index"
                 separator=",">
            (
            #{brand.typeId,jdbcType=INTEGER},
            #{brand.specId,jdbcType=INTEGER}
            )
        </foreach>
    </insert>
    <update id="updateTypeSpecBatch">
        <foreach collection="typeSpecList" item="param" index="index"
                 open="" close="" separator=";">
            update goods_type_spec
            <set>
                <if test="param.typeId != null">
                    type_id = #{param.typeId,jdbcType=INTEGER},
                </if>
                <if test="param.specId != null">
                    spec_id = #{param.specId,jdbcType=INTEGER},
                </if>
            </set>
            where type_spec_id = #{param.typeSpecId,jdbcType=INTEGER}
        </foreach>
    </update>
</mapper>
