<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.goods.mapper.ShopSelfCatMapper">

    <select id="queryShopCatIds" resultType="com.houjiang.commons.dto.goods.MerchantShopGoodsCatDTO">
        SELECT shop_goods_cat_id,shop_goods_cat_name,parent_id FROM  ${database.prefix.business}hou_shop_self_cat
        where shop_goods_cat_id in
        <foreach collection="catIdList" item="catId" index="index" separator="," open="(" close=")">
            #{catId}
        </foreach>
    </select>
</mapper>
