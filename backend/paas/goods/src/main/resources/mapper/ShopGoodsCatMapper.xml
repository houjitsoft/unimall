        shop_goods_cat_id,
        shop_goods_cat_name,
        shop_id,parent_id)
        VALUES
        <foreach collection="records" item="item" index="index" separator=",">
            (
            #{item.commonId,jdbcType=INTEGER},
            #{item.shopGoodsCatId,jdbcType=INTEGER},
            #{item.shopGoodsCatName,jdbcType=VARCHAR},
            #{item.shopId,jdbcType=INTEGER},
            #{item.parentId,jdbcType=INTEGER}
