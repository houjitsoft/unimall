    <delete id="deleteByCommonId" parameterType="java.lang.Integer">
        delete from ${database.prefix.business}hou_shop_goods_cat
        where common_id = #{commonId,jdbcType=INTEGER}
    </delete>
    <select id="queryByCommonId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
