<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.goods.mapper.SupplierGoodsYiyatongMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.goods.entity.SupplierGoodsYiyatongEntity">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="commonId" column="common_id" jdbcType="INTEGER"/>
            <result property="spuId" column="spu_id" jdbcType="VARCHAR"/>
            <result property="goodsId" column="goods_id" jdbcType="INTEGER"/>
            <result property="skuId" column="sku_id" jdbcType="VARCHAR"/>
            <result property="catId" column="cat_Id" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,common_id,spu_id,
        goods_id,sku_id,cat_Id
    </sql>
    <select id="queryYiYaTongSkuId" resultType="java.lang.String">
        select sku_id from ${database.prefix.supplier}hou_supplier_goods_yiyatong where goods_id=#{goodsId}
    </select>
    <select id="platFormQueryDealerGoods" resultType="com.houjiang.goods.vo.QueryDealerGoodsVO">
        select gc.common_name,gc.common_image,gc.cat_name,sgy.spu_id as supplyCommonId from ${database.prefix.supplier}hou_supplier_goods_yiyatong sgy left join ${database.prefix.goods}hou_goods_common gc on sgy.common_id = gc.common_id
        where gc.common_name is not null
        <if test="param.commonName != null and param.commonName != ''">
            and gc.common_name like CONCAT('%',#{param.commonName},'%')
        </if>
        group by sgy.spu_id
    </select>
    <select id="getDealerGoodsNum" resultType="java.lang.Integer">
        select count(1) from ${database.prefix.supplier}hou_supplier_goods_yiyatong where spu_id = #{supplyCommonId}
    </select>
    <select id="platFormQueryDealerShop" resultType="com.houjiang.goods.vo.QueryDealerGoodsVO">
        select gc.shop_id,gc.shop_name
        from ${database.prefix.supplier}hou_supplier_goods_yiyatong sgy left join ${database.prefix.goods}hou_goods_common gc on sgy.common_id = gc.common_id
        where gc.common_name is not null and sgy.spu_id = #{param.supplyCommonId}
        <if test="param.shopName != null and param.shopName != ''">
            and gc.shop_name like CONCAT('%',#{param.shopName},'%')
        </if>
        group by gc.shop_id
    </select>
</mapper>
