<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.goods.mapper.GoodsAttributeGroupMapper">

    <resultMap type="com.houjiang.goods.entity.GoodsAttributeGroupEntity" id="MerchantGoodsAttributeGroupMap">
        <result property="groupId" column="group_id" jdbcType="INTEGER"/>
        <result property="groupName" column="group_name" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>
    <select id="queryPage" resultType="com.houjiang.goods.vo.GoodsAttributeGroupVO">
        select group_id,group_name,create_time,group_notes
        from goods_attribute_group
        <where>
            <if test="param.groupName != null and param.groupName != ''">
                and group_name like concat('%',#{param.groupName},'%')
            </if>
        </where>
    </select>

</mapper>
