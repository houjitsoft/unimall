<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.goods.mapper.GoodsArticleResourceMapper">

    <resultMap type="com.houjiang.goods.entity.GoodsArticleResourceEntity" id="GoodsArticleResourceMap">
        <result property="resourceId" column="resource_id" jdbcType="INTEGER"/>
        <result property="articleId" column="article_id" jdbcType="VARCHAR"/>
        <result property="resourceUrl" column="resource_url" jdbcType="VARCHAR"/>
        <result property="resourceType" column="resource_type" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="lastUpdatedTime" column="last_updated_time" jdbcType="TIMESTAMP"/>
    </resultMap>
    <insert id="addArticleResources">
        insert into ${database.prefix.goods}hou_goods_article_resource(
		     article_id,
		     resource_url,
		     resource_type
		)
		values(
		       #{param.articleId,jdbcType=VARCHAR},
			   #{param.resourceUrl,jdbcType=VARCHAR},
			   #{param.resourceType,jdbcType=INTEGER}
		)
    </insert>
    <delete id="deleteArticleResources">
        delete from ${database.prefix.goods}hou_goods_article_resource
        where article_id in
        <foreach item="articleId" collection="param.articleIds" separator="," open="(" close=")" index="index">
            #{articleId}
        </foreach>
    </delete>
    <select id="getImageReources" resultType="java.lang.String">
        select resource_url from ${database.prefix.goods}hou_goods_article_resource where article_id = #{param} and resource_type = 1
    </select>
    <select id="getVideoReources" resultType="java.lang.String">
        select resource_url from ${database.prefix.goods}hou_goods_article_resource where article_id = #{param} and resource_type = 2
    </select>


</mapper>
