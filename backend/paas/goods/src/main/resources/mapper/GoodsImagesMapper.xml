    <insert id="addGoodsImages">
        insert into ${database.prefix.goods}hou_goods_images
        (common_id,
        shop_id,
        goods_id,
        images_image,
        images_displayorder,
        images_is_default)
        values(
            #{goodsBaseEntity.commonId,jdbcType=INTEGER},
            #{goodsBaseEntity.shopId,jdbcType=INTEGER},
            #{goodsBaseEntity.goodsId,jdbcType=INTEGER},
            #{goodsImage.imagesImage,jdbcType=VARCHAR},
            #{index,jdbcType=TINYINT},
            #{index,jdbcType=TINYINT}
              )
    </insert>
    <update id="updateBatch"
            parameterType="com.houjiang.commons.vo.goods.GdbMerchantGoodsImagesVO">
        <foreach collection="goodsImages" separator=";"
                 item="goodsImage">
            update ${database.prefix.goods}hou_goods_images
            <set>
                <if test="goodsImage.commonId != null">
                    common_id = #{goodsImage.commonId,jdbcType=INTEGER},
                </if>
                <if test="goodsImage.shopId != null">
                    shop_id = #{goodsImage.shopId,jdbcType=INTEGER},
                </if>
                <if test="goodsImage.goodsId != null">
                    goods_id = #{goodsImage.goodsId,jdbcType=INTEGER},
                </if>
                <if test="goodsImage.imagesImage != null">
                    images_image =
                    #{goodsImage.imagesImage,jdbcType=VARCHAR},
                </if>
                <if test="goodsImage.imagesDisplayorder != null">
                    images_displayorder =
                    #{goodsImage.imagesDisplayorder,jdbcType=TINYINT},
                </if>
                <if test="goodsImage.imagesIsDefault != null">
                    images_is_default =
                    #{goodsImage.imagesIsDefault,jdbcType=TINYINT},
                </if>
            </set>
            where images_id = #{goodsImage.imagesId,jdbcType=INTEGER}
        </foreach>
    </update>
    <update id="updateDealerGoodsImage">
        update ${database.prefix.goods}hou_goods_images
        set images_image = #{param.imagesImage}
        where images_id = #{param.imagesId}
    </update>
    <select id="selectByCommonId3" resultMap="BaseResultMap"
            parameterType="java.lang.Integer">
        select
            images_id, common_id, shop_id, images_image,
            images_displayorder,
            images_is_default
        from
            ${database.prefix.goods}hou_goods_images
        where common_id =
              #{commonId,jdbcType=INTEGER} and shop_id =#{shopId} and goods_id = #{goodsId}
    </select>
    <select id="selectByCommonId2" resultType="com.houjiang.commons.vo.goods.GdbMerchantGoodsImagesVO">
