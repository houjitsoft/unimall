<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.houjiang.activity.mapper.ActivitySpinwinPrizeMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.activity.entity.ActivitySpinwinPrizeEntity">
            <id property="prizeId" column="prize_id" jdbcType="INTEGER"/>
            <result property="prizeGrade" column="prize_grade" jdbcType="VARCHAR"/>
            <result property="prizeName" column="prize_name" jdbcType="VARCHAR"/>
            <result property="giftId" column="gift_id" jdbcType="INTEGER"/>
            <result property="activityId" column="activity_id" jdbcType="INTEGER"/>
            <result property="giftNum" column="gift_num" jdbcType="INTEGER"/>
            <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
            <result property="updateDate" column="update_date" jdbcType="TIMESTAMP"/>
            <result property="giveOutGiftNum" column="give_out_gift_num" jdbcType="INTEGER"/>
            <result property="isWin" column="is_win" jdbcType="VARCHAR"/>
            <result property="displayOrder" column="display_order" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        prize_id,prize_grade,prize_name,
        gift_id,activity_id,gift_num,
        update_by,update_date,give_out_gift_num,
        is_win,display_order
    </sql>
    <insert id="insertSpinwinPrize">
        insert into activity_spinwin_prize
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="param.prizeId != null and param.prizeId!=''">
                prize_id,
            </if>
            <if test="param.prizeGrade != null">
                prize_grade,
            </if>
            <if test="param.prizeName != null">
                prize_name,
            </if>
            <if test="param.giftId != null">
                gift_id,
            </if>
            <if test="param.activityId != null">
                activity_id,
            </if>
            <if test="param.giftNum != null">
                gift_num,
            </if>
            <if test="param.updateBy != null">
                update_by,
            </if>
            <if test="param.updateDate != null">
                update_date,
            </if>
            <if test="param.isWin != null">
                is_win,
            </if>
            <if test="param.displayOrder != null">
                display_order,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="param.prizeId != null and param.prizeId!=''">
                #{param.prizeId,jdbcType=INTEGER},
            </if>
            <if test="param.prizeGrade != null">
                #{param.prizeGrade,jdbcType=VARCHAR},
            </if>
            <if test="param.prizeName != null">
                #{param.prizeName,jdbcType=VARCHAR},
            </if>
            <if test="param.giftId != null">
                #{param.giftId,jdbcType=INTEGER},
            </if>
            <if test="param.activityId != null">
                #{param.activityId,jdbcType=INTEGER},
            </if>
            <if test="param.giftNum != null">
                #{param.giftNum,jdbcType=INTEGER},
            </if>
            <if test="param.updateBy != null">
                #{param.updateBy,jdbcType=VARCHAR},
            </if>
            <if test="param.updateDate != null">
                #{param.updateDate,jdbcType=TIMESTAMP},
            </if>
            <if test="param.isWin != null">
                #{param.isWin,jdbcType=INTEGER},
            </if>
            <if test="param.displayOrder != null">
                #{param.displayOrder,jdbcType=INTEGER},
            </if>
        </trim>
    </insert>
    <update id="updateSpinwinPrize">
        update activity_spinwin_prize
        <set>
            <if test="param.prizeGrade != null">
                prize_grade = #{param.prizeGrade,jdbcType=VARCHAR},
            </if>
            <if test="param.prizeName != null">
                prize_name = #{param.prizeName,jdbcType=VARCHAR},
            </if>
            <if test="param.giftId != null">
                gift_id = #{param.giftId,jdbcType=INTEGER},
            </if>
            <if test="param.activityId != null">
                activity_id = #{param.activityId,jdbcType=INTEGER},
            </if>
            <if test="param.giftNum != null">
                gift_num = #{param.giftNum,jdbcType=INTEGER},
            </if>
            <if test="param.updateBy != null">
                update_by = #{param.updateBy,jdbcType=VARCHAR},
            </if>
            <if test="param.updateDate != null">
                update_date = #{param.updateDate,jdbcType=TIMESTAMP},
            </if>
            <if test="param.isWin != null">
                is_win = #{param.isWin,jdbcType=INTEGER},
            </if>
            <if test="param.displayOrder != null">
                display_order = #{param.displayOrder,jdbcType=INTEGER},
            </if>
        </set>
        where prize_id = #{param.prizeId,jdbcType=INTEGER}
    </update>
    <update id="updateGiveOutGiftNum">
        update activity_spinwin_prize set give_out_gift_num=give_out_gift_num + 1
        where  activity_id = #{param.activityId} AND prize_id = #{param.prizeId}
    </update>
    <select id="selectSpinwinPrizeList" resultType="com.houjiang.activity.vo.SpinwinPrizeListVO">
    SELECT
    	ap.prize_id,
    	ap.prize_grade,
    	ap.prize_name,
    	ap.gift_id,
    	ap.activity_id,
    	ap.gift_num,
    	ap.update_by,
    	ap.is_win,
    	ap.update_date,
    	ap.display_order,
    	ap.give_out_gift_num,
    	ga.activity_title
    FROM
    	activity_spinwin_prize ap
        LEFT JOIN activity_spinwin ga ON ap.activity_id = ga.activity_id
    WHERE
    	ap.activity_id = #{param.activityId,jdbcType=INTEGER}

    ORDER BY
	ap.update_date DESC
    </select>
</mapper>
