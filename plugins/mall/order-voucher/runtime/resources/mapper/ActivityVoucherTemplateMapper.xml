<mapper namespace="com.houjiang.activity.mapper.ActivityVoucherTemplateMapper">

    <resultMap id="BaseResultMap" type="com.houjiang.activity.entity.ActivityVoucherTemplateEntity">
            <id property="voucherTId" column="voucher_t_id" jdbcType="INTEGER"/>
            <result property="voucherTTitle" column="voucher_t_title" jdbcType="VARCHAR"/>
            <result property="voucherTStartDate" column="voucher_t_start_date" jdbcType="TIMESTAMP"/>
            <result property="voucherTEndDate" column="voucher_t_end_date" jdbcType="TIMESTAMP"/>
            <result property="voucherTPrice" column="voucher_t_price" jdbcType="DECIMAL"/>
            <result property="voucherTLimit" column="voucher_t_limit" jdbcType="DECIMAL"/>
            <result property="shopId" column="shop_id" jdbcType="INTEGER"/>
            <result property="shopName" column="shop_name" jdbcType="VARCHAR"/>
            <result property="voucherTCreatorId" column="voucher_t_creator_id" jdbcType="INTEGER"/>
            <result property="voucherTState" column="voucher_t_state" jdbcType="TINYINT"/>
            <result property="voucherTTotal" column="voucher_t_total" jdbcType="INTEGER"/>
            <result property="voucherTGiveout" column="voucher_t_giveout" jdbcType="INTEGER"/>
            <result property="voucherTUsed" column="voucher_t_used" jdbcType="INTEGER"/>
            <result property="voucherTAddDate" column="voucher_t_add_date" jdbcType="TIMESTAMP"/>
            <result property="voucherTUpdateDate" column="voucher_t_update_date" jdbcType="TIMESTAMP"/>
            <result property="voucherTEachlimit" column="voucher_t_eachlimit" jdbcType="INTEGER"/>
            <result property="voucherTCustomimg" column="voucher_t_customimg" jdbcType="VARCHAR"/>
