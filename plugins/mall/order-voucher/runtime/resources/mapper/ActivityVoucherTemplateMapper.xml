            <result property="voucherBEndDate" column="voucher_b_end_date" jdbcType="TIMESTAMP"/>
    </resultMap>
    <resultMap id="VoucherTemplateMap"
               type="com.houjiang.activity.vo.HouVoucherTemplateVO">
        <id column="voucher_t_id" property="voucherTId" jdbcType="INTEGER" />
        <result column="voucher_t_title" property="voucherTTitle"
                jdbcType="VARCHAR" />
        <result column="voucher_t_start_date"
                property="voucherTStartDate" jdbcType="TIMESTAMP" />
        <result column="voucher_t_end_date" property="voucherTEndDate"
                jdbcType="TIMESTAMP" />
        <result column="voucher_t_price" property="voucherTPrice"
                jdbcType="INTEGER" />
        <result column="voucher_t_limit" property="voucherTLimit"
                jdbcType="DECIMAL" />
        <result column="shop_id" property="shopId" jdbcType="INTEGER" />
        <result column="shop_name" property="shopName"
                jdbcType="VARCHAR" />
        <result column="voucher_t_creator_id"
                property="voucherTCreatorId" jdbcType="INTEGER" />
        <result column="voucher_t_state" property="voucherTState"
                jdbcType="TINYINT" />
        <result column="voucher_t_total" property="voucherTTotal"
                jdbcType="INTEGER" />
        <result column="voucher_t_giveout" property="voucherTGiveout"
                jdbcType="INTEGER" />
        <result column="voucher_t_used" property="voucherTUsed"
                jdbcType="INTEGER" />
        <result column="voucher_t_add_date" property="voucherTAddDate"
                jdbcType="TIMESTAMP" />
        <result column="voucher_t_update_date"
                property="voucherTUpdateDate" jdbcType="TIMESTAMP" />
        <result column="voucher_t_eachlimit"
                property="voucherTEachlimit" jdbcType="INTEGER" />
    </resultMap>

    <sql id="Base_Column_List">
        voucher_t_id,voucher_t_title,
        voucher_t_start_date,voucher_t_end_date,
        voucher_t_price,voucher_t_limit,shop_id,
        shop_name,voucher_t_creator_id,voucher_t_state,
        voucher_t_total,voucher_t_giveout,voucher_t_used,
        voucher_t_add_date,voucher_t_update_date,voucher_t_eachlimit,
        voucher_t_customimg,voucher_t_remark,
        voucher_b_start_date,voucher_b_end_date
    </sql>
    <sql id="Hou_Voucher_Template">
        voucher_t_id,voucher_t_title,
		voucher_t_start_date,voucher_t_end_date,voucher_t_price,voucher_t_limit
		,shop_id,shop_name,voucher_t_creator_id,voucher_t_state,voucher_t_total
		,voucher_t_giveout,voucher_t_used,voucher_t_add_date
		,voucher_t_update_date
		,voucher_t_eachlimit
		,is_shop_voucher
    </sql>
    <select id="selectVoucherTemp" parameterType="java.util.Map"
            resultMap="VoucherTemplateMap">
        select
        <include refid="Hou_Voucher_Template" />
        from ${database.prefix.activity}hou_addon_activity_voucher_template where voucher_t_state &lt;&gt; 3
        <if test=" param.voucherTStartDate != null and param.voucherTStartDate != '' ">
            and voucher_t_start_date &gt;= #{param.voucherTStartDate}
        </if>
        <if test=" param.voucherTEndDate != null and param.voucherTEndDate != '' ">
            and voucher_t_end_date &lt;= #{param.voucherTEndDate}
        </if>
        <if test=" param.voucherTState != null and param.voucherTState != '' ">
            and voucher_t_state = #{param.voucherTState}
        </if>
        <if test=" param.voucherTTitle != null and param.voucherTTitle != '' ">
            and voucher_t_title like CONCAT('%',#{param.voucherTTitle},'%')
        </if>
        <if test=" param.isShopVoucher != null and param.isShopVoucher != ''">
            and is_shop_voucher = #{param.isShopVoucher}
        </if>
        and shop_id = #{param.shopId}
        ORDER BY voucher_t_id DESC
    </select>
    <select id="selectVoucherTempCount" parameterType="java.util.Map"
            resultType="java.lang.Integer">
        select
        count(*)
        from ${database.prefix.activity}hou_addon_activity_voucher_template where voucher_t_state &lt;&gt; 3
        <if test=" voucherTStartDate != null and voucherTStartDate != '' ">
            and voucher_t_start_date &gt;= #{voucherTStartDate}
        </if>
        <if test=" voucherTEndDate != null and voucherTEndDate != '' ">
            and voucher_t_end_date &lt;= #{voucherTEndDate}
        </if>
        <if test=" voucherTState != null and voucherTState != '' ">
            and voucher_t_state = #{voucherTState}
        </if>
        <if test=" voucherTTitle != null and voucherTTitle != '' ">
            and voucher_t_title like CONCAT('%',#{voucherTTitle},'%')
        </if>
        and shop_id = #{shopId}
    </select>
    <update id="deleteVoucherTemp">
        update ${database.prefix.activity}hou_addon_activity_voucher_template
        set voucher_t_state = 2
        where shop_id = #{shopId} and voucher_t_id = #{voucherTId}
    </update>
    <update id="updateVoucherState">
        update ${database.prefix.activity}hou_addon_activity_voucher_template
        set voucher_t_state = 2
        where shop_id = #{commonParam.shopId}
    </update>
    <insert id="insertVoucherTemplate"
            parameterType="com.houjiang.activity.dto.VoucherTemplateUpdateDTO" useGeneratedKeys="true" keyProperty="param.voucherTId" >
        insert into ${database.prefix.activity}hou_addon_activity_voucher_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="param.voucherTTitle != null">
                voucher_t_title,
            </if>
            <if test="param.voucherTStartDate != null">
                voucher_t_start_date,
            </if>
            <if test="param.voucherTEndDate != null">
                voucher_t_end_date,
            </if>
            <if test="param.voucherTPrice != null">
                voucher_t_price,
            </if>
            <if test="param.voucherTLimit != null">
                voucher_t_limit,
            </if>
            <if test="param.shopId != null">
                shop_id,
            </if>
            <if test="param.shopName != null">
                shop_name,
            </if>
            <if test="param.voucherTCreatorId != null">
                voucher_t_creator_id,
            </if>
            <if test="param.voucherTState != null">
                voucher_t_state,
            </if>
            <if test="param.voucherTTotal != null">
                voucher_t_total,
            </if>
            <if test="param.voucherTGiveout != null">
                voucher_t_giveout,
            </if>
            <if test="param.voucherTUsed != null">
                voucher_t_used,
            </if>
            <if test="param.voucherTAddDate != null">
                voucher_t_add_date,
            </if>
            <if test="param.voucherTUpdateDate != null">
                voucher_t_update_date,
            </if>
            <if test="param.voucherTEachlimit != null">
                voucher_t_eachlimit,
            </if>
            <if test="param.voucherTCustomimg != null">
                voucher_t_customimg,
            </if>
            <if test="param.isShopVoucher != null">
                is_shop_voucher,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">

            <if test="param.voucherTTitle != null">
                #{param.voucherTTitle,jdbcType=VARCHAR},
            </if>
            <if test="param.voucherTStartDate != null">
                #{param.voucherTStartDate,jdbcType=TIMESTAMP},
            </if>
            <if test="param.voucherTEndDate != null">
                #{param.voucherTEndDate,jdbcType=TIMESTAMP},
            </if>
            <if test="param.voucherTPrice != null">
                #{param.voucherTPrice,jdbcType=DECIMAL},
            </if>
            <if test="param.voucherTLimit != null">
                #{param.voucherTLimit,jdbcType=DECIMAL},
            </if>
            <if test="param.shopId != null">
                #{param.shopId,jdbcType=INTEGER},
            </if>
            <if test="param.shopName != null">
                #{param.shopName,jdbcType=VARCHAR},
            </if>
            <if test="param.voucherTCreatorId != null">
                #{param.voucherTCreatorId,jdbcType=INTEGER},
            </if>
            <if test="param.voucherTState != null">
                #{param.voucherTState,jdbcType=TINYINT},
            </if>
            <if test="param.voucherTTotal != null">
                #{param.voucherTTotal,jdbcType=INTEGER},
            </if>
            <if test="param.voucherTGiveout != null">
                #{param.voucherTGiveout,jdbcType=INTEGER},
            </if>
            <if test="param.voucherTUsed != null">
                #{param.voucherTUsed,jdbcType=INTEGER},
            </if>
            <if test="param.voucherTAddDate != null">
                now(),
            </if>
            <if test="param.voucherTUpdateDate != null">
                now(),
            </if>
            <if test="param.voucherTEachlimit != null">
                #{param.voucherTEachlimit,jdbcType=INTEGER},
            </if>
            <if test="param.voucherTCustomimg != null">
                #{param.voucherTCustomimg},
            </if>
            <if test="param.isShopVoucher != null">
                #{param.isShopVoucher},
            </if>
