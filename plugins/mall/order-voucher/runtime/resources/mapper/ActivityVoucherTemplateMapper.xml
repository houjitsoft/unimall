    </insert>
    <!-- 商家中心 -->
    <select id="selectPlatformVoucherList"
            resultType="com.houjiang.activity.vo.PlatformVoucherQueryVO">
        SELECT
            voucher_t_id,
            voucher_t_title
        FROM ${database.prefix.activity}hou_addon_activity_voucher_template
        WHERE
            NOW() BETWEEN voucher_t_start_date
                AND voucher_t_end_date
          AND voucher_t_state = 1
          <if test="shopId != null">
              and shop_id = #{shopId}
          </if>
    </select>
    <select id="selectVoucherGoodsCount"
            resultType="java.lang.Integer"
            parameterType="com.houjiang.activity.dto.JoinVoucherActivityDTO">
        SELECT
        count(1)
        FROM ${database.prefix.activity}hou_addon_activity_voucher_goods
        where
        common_id in (
        <foreach collection="param.commonIdList" item="voucherGoods"
                 index="index" separator=",">
            #{voucherGoods,jdbcType=INTEGER}
        </foreach>
        ) and voucher_t_id = #{param.voucherTId,jdbcType=INTEGER}
    </select>
    <select id="selectVoucherShopCount"
            resultType="java.lang.Integer"
            parameterType="com.houjiang.activity.dto.JoinVoucherActivityDTO">
		SELECT
		count(1)
		FROM ${database.prefix.activity}hou_addon_activity_voucher_shop
		where
		shop_id = #{param.shopId,jdbcType=INTEGER} and voucher_t_id =
		#{param.voucherTId,jdbcType=INTEGER}
	</select>
    <insert id="insertVoucherShop"
            parameterType="com.houjiang.activity.dto.JoinVoucherActivityDTO">
		insert into ${database.prefix.activity}hou_addon_activity_voucher_shop
		(shop_id,update_date,voucher_t_id,all_goods_num)
		values
		(
		#{param.shopId},now(),#{param.voucherTId},#{param.allGoodsNum}
		)
	</insert>
    <!-- 商家后台：查询代金券信息 -->
    <insert id="updateVoucherActivity"
            parameterType="com.houjiang.activity.dto.VoucherGoodsListDTO">
        insert into ${database.prefix.activity}hou_addon_activity_voucher_goods
        (common_id,shop_id,update_date,voucher_t_id)
        values
        <foreach collection="param" item="voucherGoods"
                 index="index" separator=",">
            (
            #{voucherGoods.commonId},#{voucherGoods.shopId},now(),#{voucherGoods.voucherTId}
            )
        </foreach>
    </insert>
    <!-- 商品关联活动 -->
    <insert id="updateVoucherTIdsBatch"
            parameterType="com.houjiang.activity.dto.VoucherGoodsListDTO">
        insert into ${database.prefix.activity}hou_addon_activity_voucher_common
        (common_id,shop_id,update_date,voucher_t_id)
        values
        <foreach collection="param" item="voucherGoods"
                 index="index" separator=",">
            (
            #{voucherGoods.commonId},#{voucherGoods.shopId},now(),#{voucherGoods.voucherTId}
            )
        </foreach>
    </insert>
    <select id="selectVoucherGoods"
            resultType="com.houjiang.activity.vo.VoucherGoodsQueryVO"
            parameterType="com.houjiang.activity.dto.JoinVoucherActivityDTO">
        SELECT
        vg.common_id,
        gb.common_name,
        gb.common_image,
        vg.update_date,yt.voucher_t_title
        FROM ${database.prefix.activity}hou_addon_activity_voucher_goods vg
        LEFT JOIN ${database.prefix.activity}hou_addon_activity_voucher_template yt ON yt.voucher_t_id = vg.voucher_t_id
        LEFT JOIN ${database.prefix.goods}hou_goods_common gb ON gb.common_id = vg.common_id
        where
        yt.voucher_t_state = 1 and vg.shop_id =#{param.shopId,jdbcType=INTEGER}
        <if test=" param.voucherTId != null and param.voucherTId != '' ">
            and vg.voucher_t_id = #{param.voucherTId}
        </if>
    </select>
    <select id="selectFullReduceVcList" resultType="com.houjiang.activity.vo.HouVoucherTemplateVO">
        SELECT
        voucher_t_id,
        voucher_t_title,
        voucher_t_start_date,
        voucher_t_end_date,
        voucher_t_price,
        voucher_t_limit,
        shop_id,
        voucher_t_creator_id,
        voucher_t_state,
        voucher_t_total,
        voucher_t_giveout,
        voucher_t_used,
        voucher_t_add_date,
        voucher_t_update_date,
        voucher_t_eachlimit,
        voucher_t_customimg
        FROM ${database.prefix.activity}hou_addon_activity_voucher_template
        WHERE
        NOW() &lt;= voucher_t_end_date
        AND
        voucher_t_giveout &lt;
        voucher_t_total
        AND voucher_t_state= 1
        and
        voucher_t_id in (
        <foreach collection="param.voucherTIds" item="voucherTId"
                 index="index" separator=",">
            #{voucherTId,jdbcType=INTEGER}
        </foreach>
        )
        ORDER BY
        voucher_t_price
        desc
    </select>
    <select id="salesPromotionVoucherList"
            resultType="com.houjiang.activity.entity.ActivityVoucherTemplateEntity">
        SELECT
        voucher_t_id,
        voucher_t_title,
        voucher_t_start_date,
        voucher_t_end_date,
        voucher_t_price,
        voucher_t_limit,
        shop_id,
        shop_name,
        voucher_t_creator_id,
        voucher_t_state,
        voucher_t_total,
        voucher_t_giveout,
        voucher_t_used,
        voucher_t_add_date,
        voucher_t_update_date,
        voucher_t_eachlimit,
        voucher_t_customimg,
        shop_name,
        is_shop_voucher
        FROM ${database.prefix.activity}hou_addon_activity_voucher_template
        where 1 = 1
        <if test="param.voucherTState != null and param.voucherTState != ''">
            and voucher_t_state = #{param.voucherTState}
        </if>
        <if test="param.voucherTTitle != null and param.voucherTTitle != ''">
            and voucher_t_title like  concat('%', #{param.voucherTTitle} ,'%')
        </if>
        <if test="param.shopName != null and param.shopName != ''">
            and shop_name like  concat('%', #{param.shopName} ,'%')
        </if>
          <if test="param.isShopVoucher != null and param.isShopVoucher != ''">
            and is_shop_voucher = #{param.isShopVoucher}
        </if>
        order by voucher_t_id desc
    </select>
    <select id="selectGoodsIdByVoucherCommon" resultType="java.lang.Integer">
        select avc.common_id
        from ${database.prefix.activity}hou_addon_activity_voucher_common avc
        left JOIN ${database.prefix.activity}hou_addon_activity_voucher_template avt on avc.voucher_t_id = avt.voucher_t_id
        where avt.voucher_t_state = 1 and avc.voucher_t_id = #{voucherTId}
    </select>
    <select id="queryProductVoucher" resultType="com.houjiang.activity.vo.ProductVoucherVO">
        select shop_id,voucher_t_id,voucher_t_title,voucher_t_state,voucher_t_customimg,voucher_t_start_date,voucher_t_end_date,voucher_t_eachlimit,voucher_t_add_date
        from ${database.prefix.activity}hou_addon_activity_voucher_template
        where  is_shop_voucher = 3
        <if test="param.shopId != null and param.shopId != '' ">
            and shop_id = #{param.shopId}
        </if>
        <if test="param.voucherTState != null and param.voucherTState != ''">
            and voucher_t_state = #{param.voucherTState}
        </if>
        <if test="param.voucherTTitle != null and param.voucherTTitle != '' ">
            and voucher_t_title like concat('%',#{param.voucherTTitle},'%')
        </if>
        <if test="param.voucherTStartDate != null and param.voucherTStartDate != '' ">
            and voucher_t_start_date &lt;= #{param.voucherTStartDate}
        </if>
        <if test="param.voucherTEndDate != null and param.voucherTEndDate != '' ">
            and voucher_t_end_date >= #{param.voucherTEndDate}
        </if>
        order by voucher_t_add_date desc
    </select>
    <select id="queryAllProductVoucherActivity" resultType="com.houjiang.activity.vo.ProductVoucherVO">
        select shop_id,voucher_t_id,voucher_t_title,voucher_t_state,voucher_t_customimg,voucher_t_start_date,voucher_t_end_date,voucher_t_eachlimit,voucher_t_add_date
        from ${database.prefix.activity}hou_addon_activity_voucher_template
        where  is_shop_voucher = 3 and voucher_t_state = 1
        <if test="param.shopId != null and param.shopId != '' ">
            and shop_id = #{param.shopId}
        </if>
        <if test="param.voucherTState != null and param.voucherTState != ''">
            and voucher_t_state = #{param.voucherTState}
        </if>
        <if test="param.voucherTTitle != null and param.voucherTTitle != '' ">
            and voucher_t_title like concat('%',#{param.voucherTTitle},'%')
        </if>
        <if test="param.voucherTStartDate != null and param.voucherTStartDate != '' ">
            and voucher_t_start_date &lt;= #{param.voucherTStartDate}
        </if>
        <if test="param.voucherTEndDate != null and param.voucherTEndDate != '' ">
            and voucher_t_end_date >= #{param.voucherTEndDate}
        </if>
        order by voucher_t_add_date desc
    </select>
    <select id="queryProductVoucherDetail" resultType="com.houjiang.activity.vo.ProductVoucherVO">
        SELECT
            voucher_t_id,
            voucher_t_title,
            voucher_t_state,
            voucher_t_customimg,
            voucher_t_start_date,
            voucher_t_end_date,
            voucher_t_eachlimit,
            voucher_t_add_date,
            shop_id
        FROM ${database.prefix.activity}hou_addon_activity_voucher_template
        WHERE
            voucher_t_id = #{voucherTId}
    </select>
    <select id="queryProductVoucherGoodsDetail" resultType="com.houjiang.commons.vo.goods.ProductVoucherGoodsVO">
        select common_id
        from ${database.prefix.activity}hou_addon_activity_voucher_common
        where voucher_t_id = #{param.voucherTId}
        <if test="param.commonIdList != null and param.commonIdList.size > 0 ">
           and common_id in
            <foreach collection="param.commonIdList" open="(" item="commonId" separator="," close=")">
                #{commonId}
            </foreach>
        </if>
    </select>
    <select id="queryvoucherTemplateNum" resultType="java.lang.Integer">
        SELECT
            count( 1 )
        FROM ${database.prefix.activity}hou_addon_activity_voucher_template
        WHERE
            voucher_t_id = #{voucherTId} and voucher_t_state = 1 and voucher_t_end_date >= now()    </select>
    <select id="queryVoucherTemplateGoodsNum" resultType="java.lang.Integer">
        select count(1) from ${database.prefix.activity}hou_addon_activity_voucher_common where voucher_t_id = #{voucherTId} and common_id = #{commonId}
    </select>
</mapper>
