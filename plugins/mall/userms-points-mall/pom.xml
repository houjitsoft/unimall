<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.houjiang</groupId>
        <artifactId>houjiang</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../../backend/paas/pom.xml</relativePath>
    </parent>

    <artifactId>userms-points-mall-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>UniMall 积分商城 Plugin</name>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.houjiang</groupId>
            <artifactId>commons</artifactId>
            <version>1.0-SNAPSHOT</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.rocketmq</groupId>
                    <artifactId>rocketmq-spring-boot-starter</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.rocketmq</groupId>
                    <artifactId>rocketmq-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 活动共享层：ActivitySupport（店铺归属校验/令牌）、跨服务 Feign 客户端、
             跨活动校验 VO。由 activity 拆分时提取，避免 14 个插件各持一份导致升级不同步。 -->
        <dependency>
            <groupId>com.houjiang</groupId>
            <artifactId>activity-shared</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.houjiang</groupId>
            <artifactId>plugin-sdk</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.houjiang</groupId>
            <artifactId>plugin-api</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <version>3.12.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>userms-points-mall-plugin-${project.version}</finalName>
        <sourceDirectory>${project.basedir}/runtime/java</sourceDirectory>
        <testSourceDirectory>${project.basedir}/runtime/test/java</testSourceDirectory>
        <resources>
            <resource><directory>${project.basedir}/runtime/resources</directory></resource>
            <resource><directory>${project.basedir}</directory><includes><include>plugin.yaml</include></includes></resource>
            <resource><directory>${project.basedir}/frontend</directory><targetPath>frontend</targetPath><includes><include>**/*</include></includes></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- 必须用 release 而非 source/target：后者会让 lombok 注解处理器
                         静默失效，表现为 VO/DTO 的 getter 全部「找不到符号」。 -->
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive><manifestEntries>
                        <Plugin-Id>userms-points-mall</Plugin-Id>
                        <Plugin-Version>${project.version}</Plugin-Version>
                        <Plugin-Class>com.houjiang.activity.plugin.UsermsPointsMallPlugin</Plugin-Class>
                        <Plugin-Provider>UniMall</Plugin-Provider>
                    </manifestEntries></archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
