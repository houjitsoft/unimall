# =====================================================================
# HouCloud Docker 部署环境变量
# 用法：cp .env.docker.example .env     然后按需修改（.env 已在 .gitignore 中）
#
# 说明：本文件同时被 docker-compose.yml（模式 A：全栈）与
#      docker-compose.middleware.yml（仅中间件，配合传统 jar 部署）读取；
#      模式 B（外部中间件 / host 网络）还叠加 docker-compose.hostnet.yml。
#      三种模式怎么选见 public/docs/docker/操作手册.md。
# =====================================================================

# ---------- 项目名 ----------
# compose 项目名 = 容器名前缀 + 数据卷前缀。同一台机器上要跑第二套（预发/验收/
# 客户演示）时改掉它即可共存，否则会与已有那套的容器名和卷名直接撞车。
COMPOSE_PROJECT_NAME=unimall

# ---------- 镜像 ----------
# 后端构建器镜像（一次性编译全部服务），各服务镜像从中取自己的 jar
BUILDER_IMAGE=houcloud/builder:latest
# 前端镜像名（管理后台）
ADMIN_WEB_IMAGE=houcloud/admin-web:latest
# 后端服务镜像 tag：compose 写作 unimall/<svc>:${IMAGE_TAG:-latest}。
# install.sh 构建时会自动写成 src-<源码指纹>，保证「改了代码必重建」。
# 同一台机器跑第二套（预发/验收）时必须显式改掉，否则两套互相覆盖镜像——
# 见 public/docs/docker/操作手册.md 第 8 节。
# IMAGE_TAG=oss

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0.39
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=meoc
MYSQL_USER=meoc
# 这个值会写进全部 *_*_DATASOURCE_PASSWORD 变量（所有服务共用一个库）
MYSQL_PASSWORD=change-me
MYSQL_HOST_PORT=3306

# ---------- Redis ----------
REDIS_IMAGE=redis:7.2-alpine
# 建议设非空值（模板里 password 是必填占位符）；留空也可以，初始化脚本会把它渲染成空串
REDIS_PASSWORD=change-me
REDIS_HOST_PORT=6379
# Redis 地址：nacos-init 会把它渲染进 Nacos 的 redis.yaml 下发给所有服务。
#   模式 A（全栈，compose 自带 redis 服务）→ redis:6379（默认，不用改）
#   模式 B（宿主机/外部 Redis）           → 127.0.0.1:6379
#   跨机部署                              → <真实host>:6379
# 写错的表现：服务启动即报「缺少必要的spring.redis.*配置（host/port/database）」，看着像 Redis 配置丢了，
# 实际是地址根本解析不到 / Nacos 口令不对拉不到 redis.yaml。
# REDIS_ADDR=redis:6379

# ---------- Nacos ----------
NACOS_IMAGE=nacos/nacos-server:v2.3.2
NACOS_AUTH_ENABLE=true
# 容器内 Nacos 服务端的初始口令；业务容器连它时用的口令也默认取这个值
# （编排里的实际优先级：NACOS_PASSWORD > NACOS_AUTH_PASSWORD > nacos）
NACOS_AUTH_PASSWORD=change-me
NACOS_AUTH_TOKEN=change-me-generate-with-openssl-rand-base64-32
NACOS_AUTH_IDENTITY_KEY=houcloud
NACOS_AUTH_IDENTITY_VALUE=houcloud
NACOS_NAMESPACE=houeoc
NACOS_HOST_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_RAFT_PORT=9849

# ---------- 模式 B：外部中间件 / host 网络（叠 -f docker-compose.hostnet.yml）----------
# 此时容器走宿主机网络，中间件用已有的那套。四个变量按需解开注释并填真值：
#
# NACOS_ADDR=127.0.0.1:8848        # 本机 Nacos；在别的机器上就填它的真实地址，如 127.0.0.1:8848
# NACOS_NAMESPACE=houeoc           # 不是 houcloud / public
# NACOS_USER=nacos
# NACOS_PASSWORD=change-me         # ⚠ 密码写这个变量最直观，编排优先读它
#
# 口令两个变量名都认，优先级：NACOS_PASSWORD > NACOS_AUTH_PASSWORD > 默认值 nacos。
# 上面「Nacos」段里写 NACOS_AUTH_PASSWORD 也能生效 —— 但那同时是容器内 Nacos 服务端的初始口令，
# 两个变量并存时必须一致，否则模式 A 里服务端与客户端口令不一致会静默鉴权失败。
# 判断到底渲染成什么值，以这一条为准（不要凭「我写了」来推断）：
#   docker compose -f docker-compose.yml -f docker-compose.hostnet.yml config | grep NACOS_PASSWORD
#
# ⚠ Nacos 鉴权失败的伪装性很强：服务「能连上 Nacos」（日志里有客户端启动记录），
#   但拉不到配置，最终崩在完全不相干的地方，例如
#   IllegalStateException: 缺少必要的spring.redis.*配置（host/port/database）。
#   看到这类「某配置缺失」报错，先怀疑 Nacos 的口令 / 命名空间，而不是那个配置本身。
#
# ⚠ 连远端 Nacos 时别忘了 gRPC：Nacos 2.x 客户端用 9848（=8848+1000）做注册与配置长轮询。
#   只通 8848 会出现「能拉配置但服务注册不上 / 反复 Server check fail, port 9848」。
#
# 数据源 / Redis 地址**不在此配置**：业务服务的库连接串由 Nacos 的 mutual.yaml 下发、
# Redis 由 redis.yaml 下发。模式 B 要保证外部 Nacos 里的 mutual.yaml / redis.yaml
# 已经指向正确的 MySQL / Redis 地址（用 nacos-init 渲染导入时填的就是这批值）。

# ---------- RocketMQ ----------
ROCKETMQ_IMAGE=apache/rocketmq:5.1.4
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_VIP_PORT=10909
ROCKETMQ_BROKER_HA_PORT=10912

# ---------- 端口（宿主机 -> 容器） ----------
# 管理后台 Web（Nginx）
WEB_PORT=8080
# 网关 bff-web，直接暴露方便用 curl 探活；不需要可留空
BFF_PORT=8391

# ---------- JVM ----------
# 单个微服务的 JVM 参数（容器已启用 UseContainerSupport）
JAVA_OPTS=-Xms256m -Xmx900m -Dfile.encoding=UTF-8
# 每个容器的内存上限（mall 是插件宿主，单独放宽）
SERVICE_MEM_LIMIT=1200m
MALL_MEM_LIMIT=1800m
BFF_MEM_LIMIT=1200m

# ---------- 商业服务（commerce profile） ----------
# backend/paas/ 下与 14 个核心服务同源的 10 个商业服务（crm/cms/erp/finance/im/
# mes/orderfood/pm/rider/webpos），源码在仓库里，但默认不随主栈启动（每个约 1.2GB 内存）。
# 一条命令起完整 24 业务服务（内存建议 ≥28GB）：
#   bash deploy/scripts/docker.sh full
# 或：HOUCLOUD_PROFILES=commerce bash deploy/scripts/docker.sh up
# 无需额外变量：这些服务的库/Redis/Nacos 连接与核心服务共用同一套 Nacos 下发配置。
# ⚠ 已购买「独立微服务制品」的用户改用 docker-compose.commercial.yml（自带镜像），
#   不要与本 profile 同时跑（容器名相同会冲突）。

# ---------- 可选：Elasticsearch（goods 服务的检索能力） ----------
# 默认不启动（profile: es），需要时执行：docker compose --profile es up -d
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.4
ES_PASSWORD=change-me
ES_HOST_PORT=9200

# ---------- bff-web 必填 ----------
# bff-web 的 bootstrap.yml 里这两项是无默认值的占位符（其余 13 个服务不需要）。
# 不设置会导致 bff-web 容器启动即失败：
#   Could not resolve placeholder 'XXL_JOB_PASS'
# 请自行生成随机值填入。
XXL_JOB_PASS=change-me
RESTART_ADMIN_TOKEN=change-me

# ---------- 开源前商业闭环（base 专用，密钥勿提交） ----------
# 复制 deploy/scripts/nacos-templates/artifact-commerce.env.example → 私密路径后填写，
# 并在 docker-compose.hostnet.yml 的 base.env_file 指向该文件。
# HOU_ARTIFACT_ENV_FILE=/home/houjit/.unimall/base-artifact.env
# 未配齐支付前保持：
# HOU_INTERNAL_JOB_TOKEN=
#
# 跨宿主安装静态地址（可选）。compose 已给默认安装集 userms/auth 填好 Docker DNS；
# HOU_PLUGIN_HOST_USERMS=http://userms:8195
# HOU_PLUGIN_HOST_AUTH=http://auth:8392
# HOU_PLUGIN_HOST_GOODS=http://goods:8208
# HOU_PLUGIN_HOST_ORDER=http://order:8209
# HOU_PLUGIN_HOST_CMS=http://cms:8217
# HOU_PLUGIN_HOST_TOOL=http://tool:8296
# HOU_PLUGIN_HOST_PAYMENT=http://payment:8207
#
# 站点对外地址，用于拼支付回调地址（如 https://cloud.example.com）
# HOU_BASE_PUBLIC_BASE_URL=
# HOU_PLUGIN_PAY_ENABLED=false
# 公钥配齐后生产必须：
# HOU_PLUGIN_REQUIRE_SIGNATURE=true
# HOU_ARTIFACT_TYPE=minio

# ---------- 运行期数据目录（不要放源码树里） ----------
# 容器以 root 运行，往 bind mount 里写的文件属主是 root：如果直接挂 ./plugins、./artifacts，
# 装完一次机源码树里就多出一堆普通用户删不掉的目录。统一收在 data/ 下（已在 .gitignore）。
PLUGINS_DIR=./data/plugins
ARTIFACTS_DIR=./data/artifacts
PLUGIN_SIGN_SECRETS_DIR=./data/secrets

# ---------- 分布式事务 ----------
# 容器化单机部署没有 seata-server。留 true 会让每个服务在启动阶段崩在
# globalTransactionScanner（报 service.vgroupMapping.default_tx_group 缺失）。
# 接入 seata-server 后改 true 即可。
SEATA_ENABLED=false

# ---------- 插件「发布 → 购买 → 下载 → 安装」闭环 ----------
# ⚠️ 下面 6 项在 application-plugin.yml 里都是 ${ENV:} 的 fail-closed 占位符：
#    留空 = 对应接口直接拒绝（不会静默放行）。全新机器上由 deploy/install.sh
#    自动生成一套并写回本文件，无需手工填；此处的注释即字段含义对照表。
#
# 制品下载换票密钥（HMAC-SHA256）。为空 → /artifact/download-url 拒绝签发
# HOU_ARTIFACT_DOWNLOAD_TOKEN_SECRET=
#
# 制品签名（Ed25519）。公钥格式 kid=base64，可逗号分隔多把；私钥只读挂进 base。
# 密钥对由 install.sh 用 openssl 生成到 ./secrets/（已在 .gitignore 中忽略）
# HOU_ARTIFACT_SIGN_ACTIVE_KID=k2026
# HOU_ARTIFACT_SIGN_PUBLIC_KEYS=k2026=MCowBQYDK2VwAyEA...
# HOU_ARTIFACT_SIGN_PRIVATE_KEY_PATH=/app/secrets/artifact-ed25519-k2026.key
# HOU_PLUGIN_REQUIRE_SIGNATURE=true
#
# 插件购买（市场收费闭环）。enabled=false 时下单被直接拒绝；
# channel 目前只有 CASHIER（复用商城收银台）与 MOCK（沙箱）可用。
#   试用/联调：ENABLED=true + SANDBOX=true + CHANNEL=MOCK，用 /market/pay/sandbox/confirm 模拟付款
#   🔴 正式收款：SANDBOX=false 且配好 CASHIER 的 api-key。
#      沙箱开着等于「谁都能把订单刷成已支付并领走授权」，上线前必须关。
# HOU_PLUGIN_PAY_ENABLED=true
# HOU_PLUGIN_PAY_CHANNEL=MOCK
# HOU_PLUGIN_PAY_SANDBOX=true
#
# 支付配置管理口令（/market/pay/admin/** 的准入凭据，缺失时该组接口全部 403）
# HOU_PLUGIN_PAY_ADMIN_TOKEN=
#
# 站点对外地址，用于拼支付回调地址（如 https://cloud.example.com）
# HOU_BASE_PUBLIC_BASE_URL=


# ===== AI 中台（aiagent / 注册名 ai，端口 8316）=====
# 只填网关出口兜底即可；正式用法是在后台「AI智能 → 系统设置」里录入网关地址与密钥，
# 那组值存在 hou_ai_config，优先级高于下面三个变量，改完立即生效无需重启。
# AI_GATEWAY_BASE_URL=
# AI_GATEWAY_PROFILE_KEY=
# AI_GATEWAY_DEFAULT_MODEL=mall-chat
