# UniMall 制品云存储 + 签名 + 支付 · 环境变量模板
# 复制为本机/服务器私密文件后填真实值；禁止提交含密钥的副本。
#
# MinIO Console（仅运维 UI）：（你的 MinIO Console 地址）
# MinIO S3 API（SDK / base 服务用）：本站实测 http://<你的对象存储地址>:19000
# Bucket：unimall-plugins（私有插件制品桶；现有 JAR 路径 <code>/<version>/<code>-<version>.jar）

# ---------- 制品存储（自建 MinIO：type=minio；腾讯云 COS：type=cos） ----------
HOU_ARTIFACT_TYPE=minio
HOU_ARTIFACT_MINIO_ENDPOINT=http://127.0.0.1:19000
HOU_ARTIFACT_MINIO_ACCESS_KEY=
HOU_ARTIFACT_MINIO_SECRET_KEY=
HOU_ARTIFACT_MINIO_BUCKET=unimall-plugins
HOU_ARTIFACT_MINIO_KEY_PREFIX=
HOU_ARTIFACT_MINIO_REGION=
# 若改用 COS（S3 兼容），设 HOU_ARTIFACT_TYPE=cos 并填：
# HOU_ARTIFACT_COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# HOU_ARTIFACT_COS_SECRET_ID=
# HOU_ARTIFACT_COS_SECRET_KEY=
# HOU_ARTIFACT_COS_BUCKET=unimall
# HOU_ARTIFACT_COS_REGION=ap-guangzhou
HOU_ARTIFACT_DOWNLOAD_TOKEN_SECRET=

# HOU_PUBLISH_MYSQL_HOST=127.0.0.1
# HOU_PUBLISH_MYSQL_PORT=3306
# HOU_PUBLISH_MYSQL_USER=root
# HOU_PUBLISH_MYSQL_PASSWORD=
# HOU_PUBLISH_MYSQL_DATABASE=houeoc

# ---------- 制品签名（生产必须） ----------
# 生成：
#   mkdir -p .unimall/secrets
#   java -cp plugin-platform/release/signature/target/plugin-signature-*.jar \
#     com.houjiang.plugin.signature.Ed25519KeyGen .unimall/secrets k2026
HOU_ARTIFACT_SIGN_ACTIVE_KID=k2026
HOU_ARTIFACT_SIGN_PUBLIC_KEYS=
HOU_ARTIFACT_SIGN_PRIVATE_KEY_PATH=
# 公钥配好后必须打开，否则等于生产不验签
HOU_PLUGIN_REQUIRE_SIGNATURE=true

# ---------- 插件在线购买（没配齐就不要对外宣称可买） ----------
HOU_PLUGIN_PAY_ENABLED=false
HOU_PLUGIN_PAY_CHANNEL=CASHIER
HOU_PLUGIN_PAY_SANDBOX=false
HOU_BASE_PUBLIC_BASE_URL=
HOU_PLUGIN_PAY_RETURN_URL=
HOU_PLUGIN_PAY_CASHIER_API_KEY=
HOU_PLUGIN_PAY_ADMIN_TOKEN=
# 兼容全名（Spring 松弛绑定）
HOUCLOUD_PLUGIN_MARKET_PAY_ADMIN_TOKEN=
