# =====================================================================
# HouCloud 前端镜像：Node 构建 -> Nginx 托管
#
# 构建上下文 = 仓库根目录：
#   docker build -f deploy/Dockerfile.frontend \
#     --build-arg APP_DIR=frontend/admin \
#     -t unimall/admin-web:latest .
#
# APP_DIR 可换成 frontend/pc、frontend/ucenter 等其他端（OUT_DIR 要跟着改：
# vite 端产物在 ${APP_DIR}/dist，nuxt 端在 ${APP_DIR}/.output/public）。
# 说明：刻意保留仓库内的相对目录结构（/src/frontend/admin），
#       与各端配置内的相对路径引用（如 @decoration 别名）保持一致。
# ⚠️ OUT_DIR 必须与各端构建配置的实际产物路径一致：开源树 admin 的 vite.config
#       outDir 为 'dist'（≠ 主仓的 ../../public/cloud），产物在 /src/frontend/admin/dist
#       —— 2026-10-28 第六跑实锤：OUT_DIR 指错位置时 BuildKit 报
#       「failed to calculate checksum」而非「no such file」，注意辨别。
# =====================================================================
FROM node:20-alpine AS build

ARG APP_DIR=frontend/admin
# 🔴 baseURL 必须为空：admin 的 API 封装路径里已带 /web 前缀（request.js baseURL = VITE_APP_BASE_API，
# 生产口径 = 无 .env.production → 相对路径单前缀）。这里若注入 /web，登录请求会变成 /web/web/auth/login
# 双前缀，BFF 返回 20001「请求的资源不存在」——2026-10-28 浏览器首登 404 的根因。
ARG VITE_APP_BASE_API=
ARG OUT_DIR=/src/frontend/admin/dist

# 桌面端用的 electron 二进制不需要下载；其余依赖的 postinstall（如 esbuild）必须执行
ENV NODE_OPTIONS=--max-old-space-size=4096 \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1

WORKDIR /src
COPY ${APP_DIR} ./${APP_DIR}
# 插件前端资产目录（若 vite 配置启用 host-plugin-assets 机制则需要它；
# 未启用时多拷此目录无害，为后续扩展保留）。
# .dockerignore 已排掉 plugins 下的构建产物。
COPY plugins ./plugins
# 服务架构清单：admin 端 vite.config 经 src/extensions/buildInputs.js 在模块
# 顶层读 ../../../../architecture/services.json（校验站点扩展归属服务名），
# 缺目录则 vite 加载配置即 ENOENT（2026-10-28 ① 第五轮向导装机实锤）。
COPY architecture ./architecture
# 跨端装修规则：admin 的 vite alias `@decoration` -> ../uniapp/src/components
# （ThemeStyle.vue / 装修预览 index-preview.vue 引 decoration-rules.mjs 与
# DecorationWidget.vue）。缺目录则 vite 构建期 load-fallback ENOENT（第六坑实锤）。
# 只需 src（不含 node_modules，.dockerignore 已排）。
COPY frontend/uniapp/src ./frontend/uniapp/src
WORKDIR /src/${APP_DIR}
RUN npm install --no-audit --no-fund

WORKDIR /src/${APP_DIR}
# 用 >> 追加：不摧毁 APP_DIR 自带的 .env.production（admin 无此文件等价覆盖；mall 等端有，同 key 后写覆盖先生效）
RUN echo "VITE_APP_BASE_API=${VITE_APP_BASE_API}" >> .env.production && npm run build

# ---------------------------------------------------------------- 运行时
FROM nginx:1.27-alpine

ARG OUT_DIR=/src/frontend/admin/dist

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build ${OUT_DIR} /usr/share/nginx/html
# 安装向导静态页（零构建，git 直管）：装完后 install-web 已停，
# admin-web 里的 /install/ 会显示「已安装完成」提示页而不是 404。
COPY public/install /usr/share/nginx/html/install
# 静态模板文件（工资导入等）：admin 端以 /templates/... URL 引用
# （src/constants/staticTemplates.js），运行期由 nginx 直接托管。
COPY public/templates /usr/share/nginx/html/templates

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
