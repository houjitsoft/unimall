* text=auto
*.js text eol=lf
*.scss text eol=lf
*.vue text eol=lf

# 源码与文档统一 LF，避免 Windows 本地检出时 "LF will be replaced by CRLF" 警告
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.css text eol=lf
*.properties text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制，禁止任何换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.xlsx binary
*.docx binary
*.pptx binary